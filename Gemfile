source "https://rubygems.org"

ruby ">= 3.1"

# HTTP/2 framing for requests over TLS with ALPN h2
gem "http-2", "~> 1.2"
# RFC 9535 JSONPath; match() and search() are evaluated with IRegexp instead
gem "janeway-jsonpath", "~> 1.1"
# Criteria and service files are checked against the schemas of dpp-criteria
gem "json_schemer", "~> 2.5"

group :test do
  gem "minitest", "~> 5.25"
  gem "rake", "~> 13.0"
end
